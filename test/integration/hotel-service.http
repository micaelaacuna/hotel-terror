# Manual requests for the Hotel Terror service. Run against a local `cds watch`.
#
# alice is a built-in mock dev user (admin) with no password from the default
# `auth: mocked` profile; not a secret, local development only.

@baseUrl = http://localhost:4004/hotel
@auth = Basic alice:

### Service document
GET {{baseUrl}}/
Authorization: {{auth}}

### Metadata (confirm draft annotations and value lists)
GET {{baseUrl}}/$metadata
Authorization: {{auth}}

### Bookings with guest and room expanded
GET {{baseUrl}}/Bookings?$expand=guest,room&$top=5
Authorization: {{auth}}

### Guests
GET {{baseUrl}}/Guests?$top=5
Authorization: {{auth}}

### Rooms
GET {{baseUrl}}/Rooms?$top=5
Authorization: {{auth}}

### Code lists (value helps and display)
GET {{baseUrl}}/Species
Authorization: {{auth}}

###
GET {{baseUrl}}/BookingStatuses
Authorization: {{auth}}

###
GET {{baseUrl}}/IncidentTypes
Authorization: {{auth}}

###
GET {{baseUrl}}/Extras
Authorization: {{auth}}

### Analytics - revenue by period
GET {{baseUrl}}/RevenueByPeriod
Authorization: {{auth}}

### Analytics - revenue vs target
GET {{baseUrl}}/RevenueVsTarget
Authorization: {{auth}}

### Analytics - incidents by species
GET {{baseUrl}}/IncidentsBySpecies
Authorization: {{auth}}

### Analytics - room ranking
GET {{baseUrl}}/RoomRanking
Authorization: {{auth}}

# ----------------------------------------------------------------------------
# Draft round-trip on Bookings: create -> edit -> activate -> read.
# ----------------------------------------------------------------------------

### Create a draft booking -> 201
# @name createDraft
POST {{baseUrl}}/Bookings
Authorization: {{auth}}
Content-Type: application/json

{
  "guest_ID": "11111111-1111-1111-1111-000000000003",
  "room_number": "BT-1",
  "checkIn": "2027-07-28",
  "checkOut": "2027-07-31"
}

### Edit a field on the draft -> 200
PATCH {{baseUrl}}/Bookings(ID={{createDraft.response.body.$.ID}},IsActiveEntity=false)
Authorization: {{auth}}
Content-Type: application/json

{
  "checkOut": "2027-08-01"
}

### Activate the draft -> 201
POST {{baseUrl}}/Bookings(ID={{createDraft.response.body.$.ID}},IsActiveEntity=false)/HotelService.draftActivate
Authorization: {{auth}}
Content-Type: application/json

{}

### Read the active booking -> 200
GET {{baseUrl}}/Bookings(ID={{createDraft.response.body.$.ID}},IsActiveEntity=true)
Authorization: {{auth}}

# ----------------------------------------------------------------------------
# Negative checks.
# ----------------------------------------------------------------------------

### No credentials -> expect 401
GET {{baseUrl}}/Bookings

### Client-supplied totalAmount is ignored (amount fields are @readonly) -> create draft 201, totalAmount stripped
# @name readonlyProbe
POST {{baseUrl}}/Bookings
Authorization: {{auth}}
Content-Type: application/json

{
  "guest_ID": "11111111-1111-1111-1111-000000000003",
  "room_number": "BT-1",
  "checkIn": "2026-09-25",
  "checkOut": "2026-09-27",
  "totalAmount": 99999.00
}

# ----------------------------------------------------------------------------
# Booking validation: rules fire on draft activation, not on field edits.
# Each block creates a draft, then activates it to trigger the handler.
# The draft create (POST /Bookings) returns 201; the activation returns the
# rule's status, so a rejection shows up on the activate request, not the create.
# ----------------------------------------------------------------------------

### R2 reject - vampire into a full-sun room | create draft -> 201
# @name vampireFullSun
POST {{baseUrl}}/Bookings
Authorization: {{auth}}
Content-Type: application/json

{
  "guest_ID": "11111111-1111-1111-1111-000000000001",
  "room_number": "104",
  "checkIn": "2027-04-10",
  "checkOut": "2027-04-13"
}

### Activate the draft -> 400 SUN_INCOMPATIBLE
POST {{baseUrl}}/Bookings(ID={{vampireFullSun.response.body.$.ID}},IsActiveEntity=false)/HotelService.draftActivate
Authorization: {{auth}}
Content-Type: application/json

{}

### R2 warn - vampire into a partial room | create draft -> 201
# @name vampirePartial
POST {{baseUrl}}/Bookings
Authorization: {{auth}}
Content-Type: application/json

{
  "guest_ID": "11111111-1111-1111-1111-000000000001",
  "room_number": "105",
  "checkIn": "2027-04-01",
  "checkOut": "2027-04-04"
}

### Activate the draft -> 201 + sap-messages warning
POST {{baseUrl}}/Bookings(ID={{vampirePartial.response.body.$.ID}},IsActiveEntity=false)/HotelService.draftActivate
Authorization: {{auth}}
Content-Type: application/json

{}

### R3 reject - yeti into a warm room | create draft -> 201
# @name yetiWarm
POST {{baseUrl}}/Bookings
Authorization: {{auth}}
Content-Type: application/json

{
  "guest_ID": "11111111-1111-1111-1111-000000000015",
  "room_number": "207",
  "checkIn": "2027-05-10",
  "checkOut": "2027-05-13"
}

### Activate the draft -> 400 TEMP_TOO_WARM
POST {{baseUrl}}/Bookings(ID={{yetiWarm.response.body.$.ID}},IsActiveEntity=false)/HotelService.draftActivate
Authorization: {{auth}}
Content-Type: application/json

{}

### R3 ok - yeti into the glacier suite | create draft -> 201
# @name yetiCold
POST {{baseUrl}}/Bookings
Authorization: {{auth}}
Content-Type: application/json

{
  "guest_ID": "11111111-1111-1111-1111-000000000015",
  "room_number": "ICE-1",
  "checkIn": "2027-05-01",
  "checkOut": "2027-05-04"
}

### Activate the draft -> 201
POST {{baseUrl}}/Bookings(ID={{yetiCold.response.body.$.ID}},IsActiveEntity=false)/HotelService.draftActivate
Authorization: {{auth}}
Content-Type: application/json

{}

### R4 overlap - first booking on room 13 | create draft -> 201
# @name firstStay
POST {{baseUrl}}/Bookings
Authorization: {{auth}}
Content-Type: application/json

{
  "guest_ID": "11111111-1111-1111-1111-000000000004",
  "room_number": "13",
  "checkIn": "2027-03-01",
  "checkOut": "2027-03-04"
}

### Activate the draft -> 201
POST {{baseUrl}}/Bookings(ID={{firstStay.response.body.$.ID}},IsActiveEntity=false)/HotelService.draftActivate
Authorization: {{auth}}
Content-Type: application/json

{}

### R4 overlap - clashing booking on room 13 | create draft -> 201
# @name clashStay
POST {{baseUrl}}/Bookings
Authorization: {{auth}}
Content-Type: application/json

{
  "guest_ID": "11111111-1111-1111-1111-000000000004",
  "room_number": "13",
  "checkIn": "2027-03-03",
  "checkOut": "2027-03-06"
}

### Activate the draft -> 409 ROOM_OVERLAP
POST {{baseUrl}}/Bookings(ID={{clashStay.response.body.$.ID}},IsActiveEntity=false)/HotelService.draftActivate
Authorization: {{auth}}
Content-Type: application/json

{}

# ----------------------------------------------------------------------------
# R5 pricing: amounts are computed on activation (full-moon surcharge + deposit).
# ----------------------------------------------------------------------------

### Werewolf stay spanning the 2026-10-26 full moon | create draft -> 201
# @name werewolfStay
POST {{baseUrl}}/Bookings
Authorization: {{auth}}
Content-Type: application/json

{
  "guest_ID": "11111111-1111-1111-1111-000000000003",
  "room_number": "C-1",
  "checkIn": "2026-10-25",
  "checkOut": "2026-10-28"
}

### Activate the draft -> 201
POST {{baseUrl}}/Bookings(ID={{werewolfStay.response.body.$.ID}},IsActiveEntity=false)/HotelService.draftActivate
Authorization: {{auth}}
Content-Type: application/json

{}

### Read the priced booking: expect nights 3, surcharge 28.00, deposit 200.00, total 268.00
GET {{baseUrl}}/Bookings(ID={{werewolfStay.response.body.$.ID}},IsActiveEntity=true)
Authorization: {{auth}}

# ----------------------------------------------------------------------------
# R7 lifecycle: confirmed -> checkedIn -> checkedOut, and rejected transitions.
# ----------------------------------------------------------------------------

### Create and activate a booking (defaults to confirmed) | create draft -> 201
# @name lifecycleStay
POST {{baseUrl}}/Bookings
Authorization: {{auth}}
Content-Type: application/json

{
  "guest_ID": "11111111-1111-1111-1111-000000000004",
  "room_number": "13",
  "checkIn": "2027-11-01",
  "checkOut": "2027-11-04"
}

### Activate the draft -> 201
POST {{baseUrl}}/Bookings(ID={{lifecycleStay.response.body.$.ID}},IsActiveEntity=false)/HotelService.draftActivate
Authorization: {{auth}}
Content-Type: application/json

{}

### Check in: confirmed -> checkedIn -> 200
POST {{baseUrl}}/Bookings(ID={{lifecycleStay.response.body.$.ID}},IsActiveEntity=true)/HotelService.checkIn
Authorization: {{auth}}
Content-Type: application/json

{}

### Check out: checkedIn -> checkedOut (folds charges and incidents, none here) -> 200
POST {{baseUrl}}/Bookings(ID={{lifecycleStay.response.body.$.ID}},IsActiveEntity=true)/HotelService.checkOut
Authorization: {{auth}}
Content-Type: application/json

{}

### Cancel a checked-out booking -> expect 409 CANCEL_BAD_STATE
POST {{baseUrl}}/Bookings(ID={{lifecycleStay.response.body.$.ID}},IsActiveEntity=true)/HotelService.cancel
Authorization: {{auth}}
Content-Type: application/json

{}

### Check out a fresh confirmed booking without checking in | create draft -> 201
# @name badCheckout
POST {{baseUrl}}/Bookings
Authorization: {{auth}}
Content-Type: application/json

{
  "guest_ID": "11111111-1111-1111-1111-000000000004",
  "room_number": "13",
  "checkIn": "2027-11-20",
  "checkOut": "2027-11-23"
}

### Activate the draft -> 201
POST {{baseUrl}}/Bookings(ID={{badCheckout.response.body.$.ID}},IsActiveEntity=false)/HotelService.draftActivate
Authorization: {{auth}}
Content-Type: application/json

{}

### Check out without checking in -> 409 CHECKOUT_BAD_STATE
POST {{baseUrl}}/Bookings(ID={{badCheckout.response.body.$.ID}},IsActiveEntity=true)/HotelService.checkOut
Authorization: {{auth}}
Content-Type: application/json

{}

# ----------------------------------------------------------------------------
# Dashboard functions (unbound, read-only).
# ----------------------------------------------------------------------------

### Occupancy for a seeded period: expect occupied 32, available 434, rate 7.37, target 85
# Numbers reflect the seed data on a fresh cds watch. Activating the 2026-10
# werewolf booking above adds 3 room-nights and shifts them.
GET {{baseUrl}}/occupancy(period='2026-10')
Authorization: {{auth}}

### Occupancy for a period with no bookings or target: expect all zeros
GET {{baseUrl}}/occupancy(period='2030-01')
Authorization: {{auth}}

### Next full moon: expect date, sensitiveGuestsBooked, surchargePct 35
GET {{baseUrl}}/nextFullMoon()
Authorization: {{auth}}

# ----------------------------------------------------------------------------
# Charge pricing: amount is computed from quantity and the extra price.
# Charges live under the booking draft, so add them before activating.
# ----------------------------------------------------------------------------

### Draft a booking to attach charges to -> 201
# @name chargeStay
POST {{baseUrl}}/Bookings
Authorization: {{auth}}
Content-Type: application/json

{
  "guest_ID": "11111111-1111-1111-1111-000000000004",
  "room_number": "13",
  "checkIn": "2028-01-05",
  "checkOut": "2028-01-08"
}

### Add a charge to the draft; client amount is ignored
POST {{baseUrl}}/Bookings(ID={{chargeStay.response.body.$.ID}},IsActiveEntity=false)/charges
Authorization: {{auth}}
Content-Type: application/json

{
  "extra_code": "swampSpa",
  "quantity": 3,
  "amount": 999
}

### Activate the draft -> 201
POST {{baseUrl}}/Bookings(ID={{chargeStay.response.body.$.ID}},IsActiveEntity=false)/HotelService.draftActivate
Authorization: {{auth}}
Content-Type: application/json

{}

### Read the charges: expect amount 135.00 (45.00 x 3), not 999
GET {{baseUrl}}/Bookings(ID={{chargeStay.response.body.$.ID}},IsActiveEntity=true)/charges
Authorization: {{auth}}

# ----------------------------------------------------------------------------
# Frozen bookings: no edit on a closed booking, no delete of a checked-in one.
# ----------------------------------------------------------------------------

### Create, activate, then cancel a booking | create draft -> 201
# @name frozenStay
POST {{baseUrl}}/Bookings
Authorization: {{auth}}
Content-Type: application/json

{
  "guest_ID": "11111111-1111-1111-1111-000000000004",
  "room_number": "13",
  "checkIn": "2028-03-01",
  "checkOut": "2028-03-04"
}

### Activate the draft -> 201
POST {{baseUrl}}/Bookings(ID={{frozenStay.response.body.$.ID}},IsActiveEntity=false)/HotelService.draftActivate
Authorization: {{auth}}
Content-Type: application/json

{}

### Cancel the booking -> 200
POST {{baseUrl}}/Bookings(ID={{frozenStay.response.body.$.ID}},IsActiveEntity=true)/HotelService.cancel
Authorization: {{auth}}
Content-Type: application/json

{}

### Open an editable draft of the cancelled booking -> 201, the active row is untouched
POST {{baseUrl}}/Bookings(ID={{frozenStay.response.body.$.ID}},IsActiveEntity=true)/HotelService.draftEdit
Authorization: {{auth}}
Content-Type: application/json

{}

### Change a field on the draft only
PATCH {{baseUrl}}/Bookings(ID={{frozenStay.response.body.$.ID}},IsActiveEntity=false)
Authorization: {{auth}}
Content-Type: application/json

{
  "checkOut": "2028-03-05"
}

### Save the draft -> expect 409 BOOKING_LOCKED, a frozen booking is rejected on activation
POST {{baseUrl}}/Bookings(ID={{frozenStay.response.body.$.ID}},IsActiveEntity=false)/HotelService.draftActivate
Authorization: {{auth}}
Content-Type: application/json

{}

### Create, activate and check in a booking, then try to delete it | create draft -> 201
# @name inHouseStay
POST {{baseUrl}}/Bookings
Authorization: {{auth}}
Content-Type: application/json

{
  "guest_ID": "11111111-1111-1111-1111-000000000004",
  "room_number": "13",
  "checkIn": "2028-04-01",
  "checkOut": "2028-04-04"
}

### Activate the draft -> 201
POST {{baseUrl}}/Bookings(ID={{inHouseStay.response.body.$.ID}},IsActiveEntity=false)/HotelService.draftActivate
Authorization: {{auth}}
Content-Type: application/json

{}

### Check in the booking -> 200
POST {{baseUrl}}/Bookings(ID={{inHouseStay.response.body.$.ID}},IsActiveEntity=true)/HotelService.checkIn
Authorization: {{auth}}
Content-Type: application/json

{}

### Delete a checked-in booking -> expect 409 BOOKING_IN_HOUSE_DELETE
DELETE {{baseUrl}}/Bookings(ID={{inHouseStay.response.body.$.ID}},IsActiveEntity=true)
Authorization: {{auth}}

# ----------------------------------------------------------------------------
# Room deletion guard: a room with bookings cannot be deleted.
# ----------------------------------------------------------------------------

### Delete a seeded room that has bookings -> expect 409 ROOM_HAS_BOOKINGS
DELETE {{baseUrl}}/Rooms(number='C-1',IsActiveEntity=true)
Authorization: {{auth}}
